      15 [id=15,shape=rect, label=<<font point-size="34">上报策略</font><br /><font point-size="19">[Component: server/src/settings/ReportPolicy.js; createSampleApp.js:64]</font><br /><br /><font point-size="24">box_report_policy 版本化策略；变更时经<br />TCP 会话主动下行推送</font>>, style=filled, color="#444444", fillcolor="#ffffff", fontcolor="#444444"]
      16 [id=16,shape=rect, label=<<font point-size="34">设备指令 / 抹除</font><br /><font point-size="19">[Component: server/src/settings/DeviceCommands.js; IngestService.js:56-74]</font><br /><br /><font point-size="24">待抹除下行附指令、设备确认后删档重建；板子日志 dump<br />回收</font>>, style=filled, color="#444444", fillcolor="#ffffff", fontcolor="#444444"]
      17 [id=17,shape=rect, label=<<font point-size="34">补传队列确认</font><br /><font point-size="19">[Component: server/src/settings/QueueAck.js]</font><br /><br /><font point-size="24">离线补传记录查重、入库、累计确认同一事务（box_ack*）</font>>, style=filled, color="#444444", fillcolor="#ffffff", fontcolor="#444444"]
